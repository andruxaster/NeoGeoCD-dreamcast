# ngcd-ps2: the ngcd core on the PlayStation 2 (ps2dev: ps2sdk + gsKit).
#   make -f Makefile.ps2              -> ngcd-ps2.elf (stripped; ngcd.elf with symbols),
#                                        with a log to the console / PCSX2
#   make -f Makefile.ps2 RELEASE=1    -> without the log
#   make -f Makefile.ps2 clean
# Needs PS2SDK / GSKIT set (ps2dev's environment). Objects go to obj-ps2/.

EE_BIN  = ngcd.elf
OBJDIR  = obj-ps2

CORE    = src/core/ngcd.c src/core/mem.c src/core/cd.c src/core/video.c src/core/ym2610.c
CPU     = src/ps2/cpu_famec.c src/cpu/famec/famec.c host/z80_zazu.c host/z80.c
FRONT   = src/ps2/main_ps2.c
SRCS    = $(CORE) $(CPU) $(FRONT)
EE_OBJS = $(patsubst %.c,$(OBJDIR)/%.o,$(SRCS))

GSKIT  ?= $(PS2DEV)/gsKit
EE_INCS += -Isrc/core -Isrc/cpu/famec -Ihost -I$(GSKIT)/include -I$(PS2SDK)/ports/include
EE_CFLAGS += -DNGCD_PAL_GS -DNGCD_AUDIO_RATE=22050 -Wno-unused-function -Wno-format
ifneq ($(RELEASE),1)
EE_CFLAGS += -DNGCD_PERF
endif
EE_LDFLAGS += -L$(GSKIT)/lib -L$(PS2SDK)/ports/lib
EE_LIBS = -lgskit -ldmakit -lps2_drivers -laudsrv -lpad -lmtap -lpatches -lfileXio -lmc -lm

all: $(EE_BIN)
	$(EE_STRIP) --strip-all -o ngcd-ps2.elf $(EE_BIN)

$(OBJDIR)/%.o: %.c
	@mkdir -p $(dir $@)
	$(EE_CC) $(EE_CFLAGS) $(EE_INCS) -c $< -o $@

# FAME C is one big switch-free jump table of small functions: -O2 is fine,
# -O3 only grows it
$(OBJDIR)/src/cpu/famec/famec.o: EE_CFLAGS += -Wno-unused-variable -Wno-unused-but-set-variable -Wno-unused-label

clean:
	rm -rf $(OBJDIR) $(EE_BIN) ngcd-ps2.elf

include $(PS2SDK)/samples/Makefile.pref
include $(PS2SDK)/samples/Makefile.eeglobal
