# ngcd-dc: Neo Geo CD (CDZ) emulator for the Dreamcast (KallistiOS)
#   make               -> ngcd.elf (debug: KOS banner, perf log every 2 s)
#   make RELEASE=1     -> ngcd.elf without any console output
#   make CPU_MHZ=18    -> overclocked 68000 by default (see README)
#   make anthology     -> build/anthology/: 1ST_READ.BIN (menu, scrambled)
#                         and NGCD.BIN (plain binary) for a several-games
#                         disc (see README)
# Run `make clean` when switching between RELEASE and debug.
# The PC test build lives in host/ (see README).

TARGET = ngcd.elf

OBJS = src/dc/main.o src/dc/machine_ngcd.o \
       src/dc/cpu_fame.o src/dc/z80_raze.o src/dc/video_pvr.o \
       src/core/ngcd.o src/core/mem.o src/core/cd.o src/core/video.o src/core/ym2610.o \
       src/cpu/fame/fame.o src/cpu/raze/raze.o

KOS_CFLAGS += -O3 -Wall

# 68000 clock in MHz when the disc has no NGCD.CFG (12 = hardware)
CPU_MHZ ?= 12

ifeq ($(RELEASE),1)
KOS_CFLAGS += -DNGCD_RELEASE -DNDEBUG
else
KOS_CFLAGS += -DNGCD_PERF
endif

all: $(TARGET)

include $(KOS_BASE)/Makefile.rules

# FAME SH4 68000 core (SH4 assembler from MAME4ALL DC, DIVS/CHK fixed)
src/cpu/fame/fame.o: src/cpu/fame/fame.s
	$(KOS_AS) --little -o $@ $<

# RAZE-SH4 Z80 core, generated by m4 from the RAZE-SH4 sources of MAME4ALL
# (see raze_api.h)
RAZE_SRC = src/cpu/raze/raze.s.m4 src/cpu/raze/raze.inc src/cpu/raze/raze.reg
src/cpu/raze/raze.s: $(RAZE_SRC)
	cd src/cpu/raze && m4 -DAUTODOWN_IRQS -DEMULATE_UNDOC_FLAGS -I. raze.s.m4 > raze.s

src/cpu/raze/raze.o: src/cpu/raze/raze.s
	$(KOS_AS) --little -o $@ $<

# YM2610 generated at 22050 Hz (upsampled to 44100 Hz by the machine)
src/core/ngcd.o: KOS_CFLAGS += -DNGCD_AUDIO_RATE=22050 -DNGCD_CPU_MHZ=$(CPU_MHZ)
# -O2 for video.c (on the Dreamcast only ngcd_build_quads runs from it;
# the software renderer, used by the PC build, was ~15% faster at -O2)
src/core/video.o: KOS_CFLAGS += -O2
ifneq ($(RELEASE),1)
src/core/ngcd.o: KOS_CFLAGS += -DNGCD_PROF
endif

$(TARGET): $(OBJS)
	kos-cc -o $@ $(OBJS) -lm

# ---------------------------------------------------------------- anthology
SCRAMBLE ?= $(KOS_BASE)/utils/scramble/scramble
ANTH = build/anthology

menu/menu.elf: menu/menu.c
	kos-cc -O2 -Wall -o $@ $<

anthology: $(TARGET) menu/menu.elf
	mkdir -p $(ANTH)
	$(KOS_OBJCOPY) -R .stack -O binary $(TARGET) $(ANTH)/NGCD.BIN
	$(KOS_OBJCOPY) -R .stack -O binary menu/menu.elf $(ANTH)/menu.bin
	$(SCRAMBLE) $(ANTH)/menu.bin $(ANTH)/1ST_READ.BIN
	rm -f $(ANTH)/menu.bin
	grep -qa NGCD-DISC-DIR= $(ANTH)/NGCD.BIN

clean:
	-rm -f $(TARGET) $(OBJS) menu/menu.elf src/cpu/raze/raze.s
	-rm -rf $(ANTH)

.PHONY: all clean anthology
